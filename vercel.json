{
  "version": 2,
  "buildCommand": "echo 'no build needed'",
  "outputDirectory": "apps/frontend",
  "functions": {
    "apps/backend/api/*.js": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "apps/backend/api/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
